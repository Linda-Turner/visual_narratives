import ast
import argparse
import os

import pandas as pd


def describe_images(
        input_file: str, output_dir: str, 
        model : str, 
        prompt1: str, prompt2: str, 
        credentials: str, 
        max_tokens: int, limit: int, split: str 
    ): 
    ''' 
    Generate image descriptions in two steps using a vision-language model. 
    
    Args: 
        input_file (str): Path to the input .tsv file. The file must contain the columns 'path', 'text', 'event', and 'usr_type'.  
                        'path' contains the path to the image. 
                        'text' contains the text associated with the image. 
                        'event' identifies the event or movement associated with the post. 
                        'usr_type' identifies the type of user who posted the image. 
        output_dir (str): Directory where the generated descriptions and intermediate files will be saved. 
        model (str): Model used to generate the descriptions. Supported options are 'gemma' and 'gpt'. 
        prompt1 (str): Prompt used for the first description step. If empty, the default prompt is used. 
        prompt2 (str): Prompt used for the second description step. If empty, the default prompt is used. 
        credentials (str): Path to the file containing the OpenAI credentials. Used when the 'gpt' model is selected. 
        max_tokens (int): Maximum number of tokens generated for each description. 
        limit (int): Maximum number of images to annotate. Use -1 to process all images. 
        split (str): Determines which images to annotate based on numeric filenames. 
    '''
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)    
    data_output_dir = os.path.join(output_dir, "data")
    if not os.path.exists(data_output_dir):
        os.makedirs(data_output_dir)

    # Describe images
    df = pd.read_csv(input_file, sep="\t")
    image_dir = os.path.commonpath(df["path"].tolist())
    description_step1_file = os.path.join(data_output_dir,'descriptions_step1.tsv')
    description_step2_file = os.path.join(data_output_dir,'descriptions_step2.tsv')
    two_step_descriptions(input_df=df, model=model, image_dir=image_dir, 
                            outfile_step1=description_step1_file, outfile_step2=description_step2_file,
                            prompt_step1=prompt1,prompt_step2=prompt2, 
                            credentials=credentials,
                            max_tokens=max_tokens, limit=limit, split=split)
    print(f"Descriptions saved to: {description_step2_file}")


def build_visual_narratives(
        input_file: str, 
        output_dir: str, 
        description_input_file:str, 
        n_processes: int
    ):
    ''' 
        Build visual narratives from generated image descriptions. 
        The pipeline preprocesses the image descriptions, performs syntactic parsing, clusters verb and noun phrases, 
        merges the processed descriptions with the original input data, and creates and saves narrative graphs. 
        
        Args: 
            input_file (str): Path to the original input .tsv file. The file must contain the columns 'path', 'text', 'event', and 'usr_type'. 
                                'path' contains the path to the image. 
                                'text' contains the text associated with the image. 
                                'event' identifies the event or movement associated with the post. 
                                'usr_type' identifies the type of user who posted the image. 
            output_dir (str): Directory where the processed data, clustering results, and narrative graphs will be saved. 
            description_input_file (str): Path to the .tsv file containing the generated descriptions. The file must contain the columns 'Dir', 'ImageID', and 'Labels'. 
                                            'Dir' contains the directory containing the image. 
                                            'ImageID' contains the image filename. 
                                            'Labels' contains the generated narrative description. 
            n_processes (int): Number of processes used by spaCy's nlp.pipe() for parallel processing. 
                                Use 1 for a single process or -1 to use all available CPU cores. 
            '''
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)    
    data_output_dir = os.path.join(output_dir, "data")
    if not os.path.exists(data_output_dir):
        os.makedirs(data_output_dir)
    clustering_output_dir = os.path.join(output_dir, "clustering")
    if not os.path.exists(clustering_output_dir):
        os.makedirs(clustering_output_dir)
    graphs_output_dir = os.path.join(output_dir, "graphs")
    if not os.path.exists(graphs_output_dir):
        os.makedirs(graphs_output_dir)
    
    # Preprocess image descriptions
    preprocessed_sentences_path = preprocess_sentences(description_input_file, data_output_dir, n_processes)
    preprocessed_df = pd.read_csv(
        preprocessed_sentences_path,
        converters={
            'parsed_labels': ast.literal_eval,
            'parsed_sentence': ast.literal_eval
        }
    )

    # Clustering words in image descriptions
    cluster_verb_and_noun_phrases(preprocessed_df, clustering_output_dir)

    # Update image descriptions with cluster labels and merge with data 
    updated_roles_df = update_sentences_with_clusterized(preprocessed_df, clustering_output_dir)
    updated_roles_df['path'] = (updated_roles_df['Dir'].astype(str)
    + os.sep
    + updated_roles_df['ImageID'].astype(str))
    #updated_roles_df['path'] = os.path.join(updated_roles_df['Dir'].astype(str), updated_roles_df['ImageID'].astype(str))
    original_data = pd.read_csv(input_file, sep='\t')
    merged_df = updated_roles_df.merge(original_data, on="path", how="inner")
    merged_df.to_csv(os.path.join(data_output_dir, 'processed_data.csv'), index=False)

    # Create narrative graph
    event_types = merged_df['event'].unique().tolist()
    usr_types = merged_df['usr_type'].unique().tolist()
    name2graph = create_and_save_multiple_graphs(merged_df, graphs_output_dir,event_types,usr_types)

    # Draw narrative graph
    for name, graph in name2graph.items():
        draw_graph(
            graph,
            output_filename=os.path.join(graphs_output_dir, f'{name}_graph.html')
        )

def parse_args():
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Generate visual narratives from an input TSV file.")
    parser.add_argument("--stage",
        choices=["descriptions", "narrative"],
        required=True,
        help="Pipeline stage to run: 'descriptions' to generate image descriptions, "
            "or 'narrative' to build visual narratives."
    )

    parser.add_argument("-i", "--input_file",
        help="Path to the input TSV file containing at least the columns 'event', 'usr_type', and 'path', describing the images to classify." \
            "'path' contains the directory path to the images to classify", 
        required=True)
    parser.add_argument("-o", "--output-dir",
        help="Directory where generated files will be saved.",
        default="output_narratives")
    
    # Description Generation
    parser.add_argument('-m','--model',
        choices=["gemma", "gpt"],
        help='Which VLLM model to use to generate the descriptions',
        default='gemma')
    parser.add_argument('-p1','--prompt1',
        help='Prompt to be used for the first description step to interpret the images with corresponding text.' \
                'Contains {placeholder} for inserting the movement of the tweet.',
        default='')
    parser.add_argument('-p2','--prompt2',
        help='Prompt to be used for the second description step to transform the first description step to a simple syntactic structure',
        default='')
    parser.add_argument('-c','--credentials',
        help='file with OpenAI credentials',
        default='openai_api.txt')
    parser.add_argument('-t','--max_tokens',
        help='number of tokens in description',
        default=2000,
        type = int)
    parser.add_argument('-u','--limit',
        help='max number of images to annotate (-1 if no limit)',
        default=-1,
        type = int)
    parser.add_argument('-s','--split',
        help='only annotate files with a numeric filename that is odd (o) or even (e)',
        default='none')

    # Build Visual Narrative
    parser.add_argument("-di", "--description_input_file",
        help="Path to the description input TSV file containing at least the columns 'Dir', 'ImageID', and 'Labels', " \
                "containing the descriptions of the images.", 
        default=None)
    parser.add_argument("-n", "--n_processes",
        help= "Number of processes to use in nlp.pipe() for parallel computing. Defaults to 1. " \
                "Set to -1 to use all cores on the machine.",
                        default=1,
                        type=int)
    return parser.parse_args()


if __name__ == "__main__":
    args = parse_args()
    if args.stage == "narrative" and args.description_input_file is None:
        parser.error("--description_input_file is required when --stage is 'narrative'")
    if args.stage=='descriptions':
        from generate_description.orchestrator import two_step_descriptions
        describe_images(args.input_file, args.output_dir, args.model, args.prompt1, args.prompt2, args.credentials, args.max_tokens, args.limit, args.split)
    elif args.stage=='narrative':
        from preprocessing.orchestrator import preprocess_sentences
        from clustering.orchestrator import (cluster_verb_and_noun_phrases, update_sentences_with_clusterized)
        from make_graphs.build_graph import create_and_save_multiple_graphs
        from make_graphs.draw_graph import draw_graph
        build_visual_narratives(args.input_file, args.output_dir, args.description_input_file, args.n_processes)
